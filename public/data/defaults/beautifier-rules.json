{
  "$comment": "占位内容（内容-引擎分离 §6 / D11 / D31）。5 条**自写**演示规则，覆盖对话卡 / 行内高亮 / 自带 <style> / 媒体嵌入 / 全局清理五种形态，兼作 beautifier 分段测试的 fixture 来源。🔴 一条都不许从真实规则库或第三方规则复制——那些的再分发权未定（D11）。加载器读的是 defaultEnabled（不是 enabled），见 src/sillytavern/beautifier.ts 的 loadPresetRules。",
  "version": 1,
  "rules": [
    {
      "id": "placeholder-dialogue-card",
      "name": "对话卡片（演示）",
      "scope": "maintext",
      "pattern": "\\[([^\\]]+)\\]\\(\"([\\s\\S]*?)\"\\)",
      "flags": "gm",
      "replacement": "<div class=\"ph-dialogue\"><span class=\"ph-dialogue-name\">$1</span><div class=\"ph-dialogue-body\">$2</div></div><style>.ph-dialogue{margin:8px 0;padding:8px 14px;border:1px solid var(--theme-card-border,rgba(140,120,100,0.35));border-radius:10px;background:var(--theme-card-bg,rgba(0,0,0,0.06))}.ph-dialogue-name{display:inline-block;margin-bottom:4px;font-size:0.9em;letter-spacing:0.05em;opacity:0.75}.ph-dialogue-body{line-height:1.8;text-indent:0}</style>",
      "defaultEnabled": true,
      "order": 10,
      "isBuiltin": true,
      "group": "占位演示"
    },
    {
      "id": "placeholder-emphasis",
      "name": "关键词高亮（演示）",
      "scope": "maintext",
      "pattern": "【([^】]+)】",
      "flags": "g",
      "replacement": "<span class=\"ph-emph\">$1</span><style>.ph-emph{padding:0 2px;border-bottom:1px solid currentColor;font-weight:600;opacity:0.95}</style>",
      "defaultEnabled": true,
      "order": 20,
      "isBuiltin": true,
      "group": "占位演示"
    },
    {
      "id": "placeholder-aside",
      "name": "旁白条（演示）",
      "scope": "maintext",
      "pattern": "^>>\\s*(.+)$",
      "flags": "gm",
      "replacement": "<div class=\"ph-aside\">$1</div><style>.ph-aside{margin:6px 0;padding:4px 0 4px 12px;border-left:2px solid var(--theme-accent,rgba(150,130,110,0.6));font-size:0.94em;font-style:italic;opacity:0.8;text-indent:0}</style>",
      "defaultEnabled": false,
      "order": 30,
      "isBuiltin": true,
      "group": "占位演示"
    },
    {
      "id": "placeholder-figure",
      "name": "插图嵌入（演示）",
      "scope": "maintext",
      "pattern": "\\[\\[图:([^\\]\\s]+)(?:\\s+([^\\]]*))?\\]\\]",
      "flags": "g",
      "replacement": "<figure class=\"ph-figure\"><img src=\"$1\" alt=\"$2\" loading=\"lazy\"><figcaption>$2</figcaption></figure><style>.ph-figure{margin:10px 0}.ph-figure img{display:block;max-width:100%;border-radius:8px}.ph-figure figcaption{margin-top:4px;font-size:0.85em;text-align:center;opacity:0.7}</style>",
      "defaultEnabled": false,
      "order": 40,
      "isBuiltin": true,
      "group": "占位演示"
    },
    {
      "id": "placeholder-strip-ooc",
      "name": "清理 OOC 括注（演示）",
      "scope": "global",
      "pattern": "\\(\\(\\s*OOC[:：][\\s\\S]*?\\)\\)",
      "flags": "gi",
      "replacement": "",
      "defaultEnabled": false,
      "order": 90,
      "isBuiltin": true,
      "group": "占位演示"
    }
  ]
}
