{
  "name": "narrative-engine",
  "version": "1.0.0",
  "description": "多 Agent 协作的文字 RPG 引擎（世界内容以内容包形式外挂）",
  "main": "dist/sillytavern/index.js",
  "type": "module",
  "private": true,
  "files": [
    "dist",
    "dist-ui",
    "public",
    "src",
    "server",
    "scripts",
    "docs"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "build:engine": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:vue": "vue-tsc --noEmit",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "test": "vitest",
    "test:run": "vitest --run",
    "preview": "vite preview",
    "format": "prettier --write \"{src,server,tests,scripts}/**/*.{ts,vue,css,mjs,cjs}\" \"*.{json,js,ts}\" \"*.md\" \"docs/**/*.md\" \"public/data/**/*.json\"",
    "format:check": "prettier --check \"{src,server,tests,scripts}/**/*.{ts,vue,css,mjs,cjs}\" \"*.{json,js,ts}\" \"*.md\" \"docs/**/*.md\" \"public/data/**/*.json\"",
    "knip": "knip",
    "knip:ratchet": "node scripts/knip-ratchet.mjs",
    "knip:update": "node scripts/knip-ratchet.mjs --update",
    "lint": "eslint \"{src,server,tests,scripts}/**/*.{ts,vue,mjs,cjs}\" \"*.config.{ts,js}\" --max-warnings 0",
    "lint:fix": "eslint \"{src,server,tests,scripts}/**/*.{ts,vue,mjs,cjs}\" \"*.config.{ts,js}\" --fix --max-warnings 0"
  },
  "keywords": [
    "sillytavern",
    "lorebook",
    "ai-chat"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@hono/node-server": "^2.0.12",
    "dexie": "^4.4.3",
    "fflate": "^0.8.3",
    "hono": "^4.12.32",
    "openseadragon": "^6.0.2",
    "pinia": "^2.3.1",
    "quickjs-emscripten": "^0.32.0",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/openseadragon": "^5.0.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "jsdom": "^29.1.1",
    "knip": "^6.31.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "typescript": "^5.4.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.8"
  }
}
