{
  "name": "IndependentFront-for-destined-journey",
  "version": "1.0.0",
  "description": "IndependentFront for Destined Journey — 命定之诗独立前端，多 Agent 文字 RPG 引擎",
  "main": "dist/sillytavern/index.js",
  "type": "module",
  "scripts": {
    "dev": "dev.bat",
    "build": "vite build",
    "build:engine": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:vue": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest --run",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"*.json\" \"*.md\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"*.json\" \"*.md\" \"docs/**/*.md\"",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "lint:fix": "eslint \"src/**/*.{ts,vue}\" --fix"
  },
  "keywords": [
    "sillytavern",
    "lorebook",
    "ai-chat"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "dexie": "^4.4.3",
    "fflate": "^0.8.3",
    "hono": "^4.12.32",
    "openseadragon": "^6.0.2",
    "pinia": "^2.3.1",
    "vue": "^3.5.38",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/openseadragon": "^5.0.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.4.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.8"
  }
}
